  },

  "vocabulary_rules": {
    "forbidden": [
      "ecossistema (substituir por: 'atuação estratégica', 'rede municipal', 'articulação', 'microcosmo de inovação', 'tecido institucional')",
      "Fale Conosco (substituir por: 'Conecte-se')"
    ],
    "required": [
      "Numerais com zero à esquerda: Eixo 01, Eixo 02, Eixo 03",
      "INPACTAS sempre em caixa alta",
      "DataB e RHISA com capitalização exata",
      "Sem emojis em documentos institucionais"
    ]
